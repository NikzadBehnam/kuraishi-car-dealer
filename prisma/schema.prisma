generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCondition {
  used
  demonstrator
  annual
}

enum VehicleFuelType {
  petrol
  diesel
  electric
  hybrid
}

enum VehicleTransmissionType {
  automatic
  manual
}

enum VehicleBodyType {
  suv
  compact
  sedan
  wagon
  van
  sports
}

enum VehicleConsumptionUnit {
  l_per_100_km
  kwh_per_100_km
}

enum VehicleStatus {
  draft
  published
  reserved
  sold
  archived
}

enum VehicleInspectionStatus {
  pending
  in_progress
  passed
  failed
}

model Dealer {
  id       String    @id @default(cuid())
  name     String
  vehicles Vehicle[]
}

model Vehicle {
  id                String                   @id @default(cuid())
  slug              String                   @unique
  stockNumber       String                   @unique
  make              String
  model             String
  variant           String?
  description       String?
  location          String?
  exteriorColor     String?
  condition         VehicleCondition?
  price             Decimal?                 @db.Decimal(12, 2)
  marginEstimate    Decimal?                 @db.Decimal(12, 2)
  firstRegistration String?                  @db.VarChar(7)
  mileage           Int?
  powerKw           Decimal?                 @db.Decimal(7, 2)
  ownerCount        Int?
  vinLastSix        String?                  @db.VarChar(6)
  fuelType          VehicleFuelType?
  transmissionType  VehicleTransmissionType?
  bodyType          VehicleBodyType?
  consumption       Decimal?                 @db.Decimal(6, 2)
  consumptionUnit   VehicleConsumptionUnit?
  co2Emission       Int?
  features          String[]                 @default([])
  labels            String[]                 @default([])
  status            VehicleStatus            @default(draft)
  inspectionStatus  VehicleInspectionStatus  @default(pending)
  isFeatured        Boolean                  @default(false)
  acquisitionDate   DateTime                 @db.Date
  publishedAt       DateTime?                @db.Timestamptz(3)
  reservedUntil     DateTime?                @db.Timestamptz(3)
  soldAt            DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  version           Int                      @default(1)
  createdById       String
  createdBy         User                     @relation("VehicleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       String
  updatedBy         User                     @relation("VehicleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  changes           VehicleChange[]
  dealerId          String
  dealer            Dealer                   @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  @@index([dealerId])
  @@index([updatedAt(sort: Desc), id])
  @@index([status, updatedAt(sort: Desc), id])
  @@index([status, inspectionStatus, isFeatured, id])
  @@index([createdById])
  @@index([updatedById])
}

model VehicleChange {
  id                       String                   @id @default(cuid())
  vehicleId                String
  vehicle                  Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  actorId                  String
  actor                    User                     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt               DateTime                 @default(now()) @db.Timestamptz(3)
  version                  Int
  previousStatus           VehicleStatus?
  status                   VehicleStatus
  previousInspectionStatus VehicleInspectionStatus?
  inspectionStatus         VehicleInspectionStatus
  previousSoldAt           DateTime?                @db.Timestamptz(3)
  soldAt                   DateTime?                @db.Timestamptz(3)

  @@unique([vehicleId, version])
  @@index([actorId])
}

model User {
  id              String          @id
  name            String
  email           String
  emailVerified   Boolean         @default(false)
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  role            String?
  banned          Boolean?        @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]
  createdVehicles Vehicle[]       @relation("VehicleCreator")
  updatedVehicles Vehicle[]       @relation("VehicleUpdater")
  vehicleChanges  VehicleChange[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
