generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCondition {
  used
  demonstrator
  annual
}

enum VehicleFuelType {
  petrol
  diesel
  electric
  hybrid
}

enum VehicleTransmissionType {
  automatic
  manual
}

enum VehicleBodyType {
  suv
  compact
  sedan
  wagon
  van
  sports
}

enum VehicleConsumptionUnit {
  l_per_100_km
  kwh_per_100_km
}

enum VehicleStatus {
  draft
  published
  reserved
  sold
  archived
}

enum VehicleInspectionStatus {
  pending
  in_progress
  passed
  failed
}

enum MediaAssetType {
  image
  document
  brand
}

enum MediaBucketAccess {
  private
  public_read
}

enum InquirySource {
  contact
  test_drive @map("test-drive")
  callback
}

enum InquiryService {
  test_drive
  consultation
  vehicle_valuation
  workshop
  callback
}

enum InquiryNotificationStatus {
  disabled
  pending
  sending
  retry
  sent
  failed
}

model Dealer {
  id               String    @id @default(cuid())
  name             String
  shortName        String    @default("Kuraishi") @db.VarChar(100)
  tagline          String    @default("Ihr Fahrzeug. Ihre Entscheidung.") @db.VarChar(160)
  websiteUrl       String    @default("https://www.kuraishi-autohandel.at") @db.VarChar(2048)
  description      String    @default("Geprüfte Gebrauchtwagen, transparente Angebote und persönliche Beratung in Wien.") @db.Text
  phone            String    @default("+43 664 123 45 67") @db.VarChar(32)
  phone2           String?   @db.VarChar(32)
  phone3           String?   @db.VarChar(32)
  legalForm        String?   @db.VarChar(100)
  businessActivity String?   @db.VarChar(160)
  email            String    @default("office@kuraishi-autohandel.at") @db.VarChar(254)
  street           String    @default("Treustraße 57/4/3") @db.VarChar(255)
  postalCode       String    @default("1200") @db.VarChar(32)
  city             String    @default("Wien") @db.VarChar(120)
  country          String    @default("Österreich") @db.VarChar(120)
  mapUrl           String    @default("https://maps.google.com/?q=Treustraße+57%2F4%2F3%2C+1200+Wien") @db.VarChar(2048)
  version          Int       @default(1)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  vehicles         Vehicle[]
}

model Vehicle {
  id                String                   @id @default(cuid())
  slug              String                   @unique
  stockNumber       String                   @unique
  make              String
  model             String
  variant           String?
  description       String?
  location          String?
  exteriorColor     String?
  condition         VehicleCondition?
  price             Decimal?                 @db.Decimal(12, 2)
  marginEstimate    Decimal?                 @db.Decimal(12, 2)
  firstRegistration String?                  @db.VarChar(7)
  mileage           Int?
  powerKw           Decimal?                 @db.Decimal(7, 2)
  ownerCount        Int?
  vinLastSix        String?                  @db.VarChar(6)
  fuelType          VehicleFuelType?
  transmissionType  VehicleTransmissionType?
  bodyType          VehicleBodyType?
  consumption       Decimal?                 @db.Decimal(6, 2)
  consumptionUnit   VehicleConsumptionUnit?
  co2Emission       Int?
  features          String[]                 @default([])
  labels            String[]                 @default([])
  status            VehicleStatus            @default(draft)
  inspectionStatus  VehicleInspectionStatus  @default(pending)
  isFeatured        Boolean                  @default(false)
  acquisitionDate   DateTime                 @db.Date
  publishedAt       DateTime?                @db.Timestamptz(3)
  reservedUntil     DateTime?                @db.Timestamptz(3)
  soldAt            DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  version           Int                      @default(1)
  createdById       String
  createdBy         User                     @relation("VehicleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById       String
  updatedBy         User                     @relation("VehicleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  changes           VehicleChange[]
  mediaAttachments  VehicleMedia[]
  inquiries         Inquiry[]
  dealerId          String
  dealer            Dealer                   @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  @@index([dealerId])
  @@index([updatedAt(sort: Desc), id])
  @@index([status, updatedAt(sort: Desc), id])
  @@index([status, inspectionStatus, isFeatured, id])
  @@index([createdById])
  @@index([updatedById])
}

model Inquiry {
  id                    String               @id @default(cuid())
  customerName          String               @db.VarChar(200)
  customerEmail         String               @db.VarChar(254)
  customerPhone         String?              @db.VarChar(32)
  message               String               @db.VarChar(1000)
  source                InquirySource
  requestedService      InquiryService
  preferredDate         DateTime?            @db.Date
  vehicleId             String?
  vehicle               Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleSlugSnapshot   String?              @db.VarChar(200)
  vehicleTitleSnapshot  String?              @db.VarChar(500)
  privacyNoticeVersion  String               @db.VarChar(64)
  privacyNoticeText     String               @db.Text
  privacyAcknowledgedAt DateTime             @db.Timestamptz(3)
  submissionKey         String?              @unique @db.Uuid
  submissionHash        String?              @db.VarChar(64)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  notification          InquiryNotification?
  notes                 InquiryNote[]

  @@index([createdAt(sort: Desc), id])
  @@index([vehicleId])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([inquiryId, createdAt, id])
  @@index([authorId])
}

model InquiryNotification {
  id                String                    @id @default(cuid())
  inquiryId         String                    @unique
  inquiry           Inquiry                   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status            InquiryNotificationStatus
  attemptCount      Int                       @default(0)
  nextAttemptAt     DateTime                  @default(now()) @db.Timestamptz(3)
  leaseExpiresAt    DateTime?                 @db.Timestamptz(3)
  idempotencyKey    String                    @unique @db.VarChar(80)
  providerMessageId String?                   @db.VarChar(200)
  lastErrorCode     String?                   @db.VarChar(64)
  sentAt            DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
}

model InquiryRateLimit {
  key       String   @id @db.VarChar(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model VehicleChange {
  id                       String                   @id @default(cuid())
  vehicleId                String
  vehicle                  Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  actorId                  String
  actor                    User                     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt               DateTime                 @default(now()) @db.Timestamptz(3)
  version                  Int
  previousStatus           VehicleStatus?
  status                   VehicleStatus
  previousInspectionStatus VehicleInspectionStatus?
  inspectionStatus         VehicleInspectionStatus
  previousSoldAt           DateTime?                @db.Timestamptz(3)
  soldAt                   DateTime?                @db.Timestamptz(3)

  @@unique([vehicleId, version])
  @@index([actorId])
}

model MediaAsset {
  id                 String            @id @default(cuid())
  objectKey          String            @db.VarChar(1024)
  bucketAccess       MediaBucketAccess
  type               MediaAssetType
  title              String            @db.VarChar(255)
  originalFilename   String            @db.VarChar(255)
  altText            String?
  verifiedMimeType   String            @db.VarChar(127)
  sizeBytes          BigInt
  width              Int?
  height             Int?
  uploadedAt         DateTime          @default(now()) @db.Timestamptz(3)
  uploadedById       String
  uploadedBy         User              @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  publicApprovedAt   DateTime?         @db.Timestamptz(3)
  publicApprovedById String?
  publicApprovedBy   User?             @relation("MediaPublicApprover", fields: [publicApprovedById], references: [id], onDelete: Restrict)
  vehicleAttachment  VehicleMedia?

  @@unique([bucketAccess, objectKey])
  @@index([type, bucketAccess])
  @@index([uploadedAt(sort: Desc), id])
  @@index([uploadedById])
  @@index([publicApprovedById])
}

model VehicleMedia {
  vehicleId    String
  mediaAssetId String     @unique
  position     Int        @db.SmallInt
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([vehicleId, position])
}

model MediaUploadIntent {
  id               String         @id
  objectKey        String         @db.VarChar(1024)
  stagingKey       String         @unique @db.VarChar(1024)
  type             MediaAssetType
  title            String         @db.VarChar(255)
  originalFilename String         @db.VarChar(255)
  altText          String?
  claimedMimeType  String         @db.VarChar(127)
  sizeBytes        BigInt
  uploadedById     String
  uploadedBy       User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime       @db.Timestamptz(3)
  completedAt      DateTime?      @db.Timestamptz(3)
  cancelledAt      DateTime?      @db.Timestamptz(3)

  @@unique([objectKey])
  @@index([uploadedById, createdAt])
  @@index([expiresAt])
}

model User {
  id                  String              @id
  name                String
  email               String
  emailVerified       Boolean             @default(false)
  image               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  role                String?
  banned              Boolean?            @default(false)
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]
  authoredInquiryNotes InquiryNote[]
  createdVehicles     Vehicle[]           @relation("VehicleCreator")
  updatedVehicles     Vehicle[]           @relation("VehicleUpdater")
  vehicleChanges      VehicleChange[]
  uploadedMedia       MediaAsset[]        @relation("MediaUploader")
  approvedPublicMedia MediaAsset[]        @relation("MediaPublicApprover")
  mediaUploadIntents  MediaUploadIntent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
