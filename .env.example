# Neon pooled connection (host contains "-pooler"): used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?channel_binding=require&sslmode=require"
# Neon direct connection (no "-pooler"): used by Prisma CLI migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?channel_binding=require&sslmode=require"
# Random secret, at least 32 characters (for example: openssl rand -base64 48). Never reuse across environments.
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Canonical application origin: http://localhost:3000 locally, https://www.kuraishicars.com in production
BETTER_AUTH_URL="http://localhost:3000"
# Inquiry intake stays OFF by default and cannot be enabled in Production until legal approval.
# Enable only against verified isolated resources in local development or Vercel Preview.
INQUIRY_TEST_MODE="false"
# Separate random secret (at least 32 characters), never reuse auth credentials.
# Required only when INQUIRY_TEST_MODE=true. Never commit a real value.
INQUIRY_HASH_SECRET=""
# Staff-only inquiry notifications: disabled by default; only isolated test mode is implemented.
# No email transport is connected yet. Never use NEXT_PUBLIC_ names for these settings.
INQUIRY_EMAIL_MODE="disabled"
RESEND_API_KEY=""
# Verify this sending subdomain in your Resend account before provider testing.
INQUIRY_EMAIL_FROM="anfragen@notifications.kuraishicars.com"
# Test mode accepts only Resend's simulator, never real staff/customer recipients.
INQUIRY_EMAIL_TO="delivered@resend.dev"
# Exact isolated app origin (no trailing slash); Preview uses its current https://<deployment>.vercel.app.
INQUIRY_EMAIL_INBOX_ORIGIN="http://localhost:3000"
