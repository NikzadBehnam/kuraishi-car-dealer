{
  "name": "kuraishi-car-dealer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-isolation=none --experimental-strip-types src/**/*.test.ts",
    "test:watch": "node --test --watch --test-isolation=none --experimental-strip-types src/**/*.test.ts",
    "test:inventory-db": "node --env-file=.env.inventory-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\inventory-migration.test.ts prisma\\inventory-queries.test.ts",
    "test:media-db": "node --env-file=.env.media-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\media-migration.test.ts",
    "test:media-upload": "node --env-file=.env.media-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\media-uploads.test.ts",
    "test:media-library": "node --env-file=.env.media-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\media-library.test.ts",
    "test:media-downloads": "node --env-file=.env.media-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\media-downloads.test.ts",
    "test:vehicle-media": "node --env-file=.env.media-test.local --conditions=react-server --experimental-test-module-mocks --test --test-isolation=none --experimental-strip-types prisma\\vehicle-media.test.ts",
    "test:media-storage": "node --env-file=.env.media-test.local --conditions=react-server --test --test-isolation=none --experimental-strip-types prisma\\media-storage.test.ts",
    "inventory:fixtures": "node --env-file=.env.inventory-test.local --experimental-strip-types prisma\\seed-inventory.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-presigned-post": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "@better-auth/prisma-adapter": "1.7.23",
    "@hookform/resolvers": "latest",
    "@neondatabase/serverless": "1.2.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "1.7.23",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "^4.4.0",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "latest",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "server-only": "0.0.1",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "ws": "8.23.0",
    "yazl": "3.3.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "8.18.2",
    "@types/yazl": "3.3.1",
    "eslint": "9.39.4",
    "eslint-config-next": "latest",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "latest",
    "prisma": "7.10.1",
    "tailwindcss": "latest",
    "typescript": "^6.0.3"
  }
}
