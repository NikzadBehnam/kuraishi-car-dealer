# Public browser-readable values.
# These are safe to expose to client-side code because they use NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_PROVIDER_KEY=""
NEXT_PUBLIC_ANALYTICS_ID=""

# Server-only Neon PostgreSQL / Prisma values.
# Use the pooled Neon URL for application runtime. Neon pooled hosts include "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
# Use the direct Neon URL for Prisma CLI migrations. Direct hosts omit "-pooler".
# Prisma 7 should consume this from prisma.config.ts as datasource.url for migration commands.
DIRECT_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
# Keep disabled by default. Set to IMPORT_MOCK_CATALOG only for an explicit
# local/development catalogue import.
ALLOW_DEVELOPMENT_SEED="false"

# Server-only Better Auth values.
# Generate a strong secret with:
#   openssl rand -base64 32
# or, with the Better Auth CLI:
#   pnpm dlx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-generated-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Production Better Auth URL:
# BETTER_AUTH_URL="https://kuraishi-car-dealer.vercel.app"

# Server-only Resend values.
RESEND_API_KEY="re_REPLACE_WITH_RESEND_API_KEY"
# Must use a custom domain verified in Resend, not the Vercel app subdomain.
# Example after verifying mail.example.com: "Kuraishi Autohandel <auth@mail.example.com>"
RESEND_FROM_EMAIL="Kuraishi Autohandel <no-reply@example.com>"
RESEND_REPLY_TO_EMAIL="office@example.com"

# Server-only Google OAuth values.
# Leave both values empty until Google sign-in is configured.
# Better Auth enables the Google provider only when both values are present.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://kuraishi-car-dealer.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server-only first-admin seed values.
# The seed script creates this user idempotently with role ADMIN.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_FIRST_NAME="Kuraishi"
SEED_ADMIN_LAST_NAME="Admin"
SEED_ADMIN_PASSWORD="replace-with-a-long-random-initial-password"
