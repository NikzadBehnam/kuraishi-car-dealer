# Neon pooled connection (host contains "-pooler"): used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?channel_binding=require&sslmode=require"
# Neon direct connection (no "-pooler"): used by Prisma CLI migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?channel_binding=require&sslmode=require"
# Random secret, at least 32 characters (for example: openssl rand -base64 48). Never reuse across environments.
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Canonical application origin: http://localhost:3000 locally, https://www.kuraishicars.com in production
BETTER_AUTH_URL="http://localhost:3000"
